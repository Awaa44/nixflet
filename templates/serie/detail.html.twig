{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}| {{ serie.name }} {% endblock %}

{% block body %}

    <style>
        body {
            background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.9)),
            url("{{ asset('resources/backdrops/' ~serie.backdrop) }}");
        }
    </style>

    <h2>{{ serie.name }}</h2>
    <span class="badge bg-info">{{ serie.status }}</span>
    <span class="badge bg-info">{{ serie.firstAirDate|date('d/m/Y') }}</span>
    <p>{{ serie.overview }}</p>
    <br>
    {% if is_granted('ROLE_CONTRIB') %}
        <div>
            <a href="{{ path('app_serie_update', {id: serie.id }) }}" class="btn btn-primary">Modifier</a>
            {% if is_granted('ROLE_ADMIN') %}
            {# création d'un token de sécurité pour la suppression #}
            <a href="{{ path('app_serie_delete', {id: serie.id, token: csrf_token('serie_delete' ~ serie.id)}) }}"
               class = "btn btn-danger"
               onclick="return confirm('Etes-vous sûr???')">Supprimer</a>
            {% endif %}
        </div>
    {% endif %}
    {# ajout de l'affichage de la liste des saisons disponibles #}
    <section>
        <ul>
            {% for season in serie.seasons %}
                <li>{{ season.number }} : {{ season.overview }} - {{ season.firstAirDate|date('d/m/Y') }}
                    <a href="{{ path('app_season_update', {id: season.id}) }}">Modifier</a></li>
            {% endfor %}
        </ul>
    </section>

{% endblock %}
