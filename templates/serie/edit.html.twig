{% extends 'base.html.twig' %}

{#Le thème est récupéré dans le dossier vendor#}
{% form_theme serie_form 'bootstrap_5_layout.html.twig' %}

{% block title %}{{ parent() }} |
    {{ serie is defined ? 'Editer la série' ~serie.id : 'Création Série'}} {% endblock %}

{% block body %}
    {% if serie is defined %}
        <h2>Modifier la série {{ serie.name }}</h2>
    {% else %}
        <h2>Créer une nouvelle série</h2>
    {% endif %}

    <div class="row justify-content-center">
        <div class="col-12 col-md-6">
            {{ form(serie_form) }}
        </div>
    </div>
{% endblock %}
